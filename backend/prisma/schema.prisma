generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id                  String             @id @default(uuid())
  name                String
  email               String
  phone               String
  serviceType         String
  message             String?
  status              String             @default("NEW")
  clientId            String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  appointments        Appointment[]
  client              Client?            @relation("ClientLeads", fields: [clientId], references: [id])
  qualification       LeadQualification?
  sequenceAssignments LeadSequence[]
  responses           Response[]
}

model Appointment {
  id              String    @id @default(uuid())
  leadId          String
  clientId        String?
  scheduledAt     DateTime
  durationMinutes Int       @default(60)
  status          String    @default("SCHEDULED")
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  calendarEventId String?
  confirmedAt     DateTime?
  reminded1hAt    DateTime?
  reminded24hAt   DateTime?
  lead            Lead      @relation(fields: [leadId], references: [id])
}

model LeadQualification {
  id              String   @id @default(uuid())
  leadId          String   @unique
  status          String   @default("UNQUALIFIED")
  propertyDetails Json?
  urgency         String?
  budgetRange     String?
  serviceNeeded   String?
  updatedAt       DateTime @updatedAt
  lead            Lead     @relation(fields: [leadId], references: [id])
}

model FollowUpSequence {
  id          String         @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  steps       FollowUpStep[]
  assignments LeadSequence[]
}

model FollowUpStep {
  id         String           @id @default(uuid())
  sequenceId String
  day        Int
  type       String
  template   String
  subject    String?
  sequence   FollowUpSequence @relation(fields: [sequenceId], references: [id])
  responses  Response[]

  @@unique([sequenceId, day, type])
}

model LeadSequence {
  id         String           @id @default(uuid())
  leadId     String
  sequenceId String
  status     String           @default("ACTIVE")
  currentDay Int              @default(0)
  nextSendAt DateTime
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  lead       Lead             @relation(fields: [leadId], references: [id])
  sequence   FollowUpSequence @relation(fields: [sequenceId], references: [id])
  responses  Response[]

  @@unique([leadId, sequenceId])
}

model Response {
  id             String        @id @default(uuid())
  leadId         String
  type           String
  content        String
  sentAt         DateTime      @default(now())
  createdAt      DateTime      @default(now())
  clickedAt      DateTime?
  leadSequenceId String?
  openedAt       DateTime?
  stepId         String?
  lead           Lead          @relation(fields: [leadId], references: [id])
  leadSequence   LeadSequence? @relation(fields: [leadSequenceId], references: [id])
  step           FollowUpStep? @relation(fields: [stepId], references: [id])
}

model MissedCall {
  id          String    @id @default(uuid())
  phone       String
  fromCity    String?
  fromState   String?
  fromCountry String?
  callSid     String    @unique
  respondedAt DateTime?
  forwardedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Client {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  leads     Lead[]   @relation("ClientLeads")
}
